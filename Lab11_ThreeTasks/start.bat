@echo off
chcp 65001 >nul
setlocal
set "APP_ROOT=%~dp0"
set "PORT=8000"

echo ==============================================
echo   Лабораторная работа №11 — запуск приложения
echo ==============================================

REM Проверяем, не занят ли порт 8000.
powershell -NoProfile -Command "$c=New-Object Net.Sockets.TcpClient; try { $c.Connect('127.0.0.1',8000); exit 0 } catch { exit 1 } finally { $c.Close() }" >nul 2>&1
if %errorlevel%==0 (
  echo Сервер уже запущен на порту 8000.
) else (
  echo Запускаю локальный сервер...
  start "React Lab 11 server" powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
  timeout /t 3 /nobreak >nul
)
start "" "http://localhost:8000"
echo Браузер открыт: http://localhost:8000
echo Закройте окно сервера PowerShell, чтобы остановить сервер.
endlocal
